# Safe to expose in the browser: the project URL, the *publishable* (anon) key, and the
# Turnstile SITE key. NEVER put the service-role key, the Google API key, or the Turnstile
# SECRET key here. Those live in Supabase secrets (see README).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Optional: the public address printed into QR codes. Defaults to the address you're browsing.
# VITE_PUBLIC_BASE_URL=https://reviews.yourbusiness.com
